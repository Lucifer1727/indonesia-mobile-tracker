GMAIL_APP_PASSWORD=abcdefghijklmnop
NOTIFY_EMAIL=you@gmail.com
# To notify TWO (or more) addresses, comma-separate them:
# NOTIFY_EMAIL=you@gmail.com, second@gmail.com
